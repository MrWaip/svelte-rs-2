{
  "name": "svelte-rs",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "initializeCommand": "sh .devcontainer/initialize.sh",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--cap-add=PERFMON",
    "--security-opt",
    "seccomp=unconfined"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/svelte-rs,type=bind,consistency=delegated",
  "workspaceFolder": "/workspaces/svelte-rs",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/settings.local.json,target=/workspaces/svelte-rs/.claude/settings.local.json,type=bind",
    "source=svelte-rs-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=svelte-rs-cargo-registry,target=/usr/local/cargo/registry,type=volume",
    "source=svelte-rs-cargo-git,target=/usr/local/cargo/git,type=volume",
    "source=svelte-rs-target,target=/workspaces/svelte-rs/target,type=volume",
    "source=svelte-rs-node-modules,target=/workspaces/svelte-rs/node_modules,type=volume"
  ],
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "containerEnv": {
    "CARGO_HOME": "/usr/local/cargo",
    "RUSTUP_HOME": "/usr/local/rustup",
    "CARGO_TERM_COLOR": "always",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "TERM": "xterm-256color",
    "COLORTERM": "truecolor"
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "./local-mounts": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "skellock.just",
        "eamodio.gitlens"
      ],
      "settings": {
        "rust-analyzer.server.path": "/usr/local/cargo/bin/rust-analyzer",
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.gpuAcceleration": "off"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "if [ '${localEnv:HOME}' != '/home/vscode' ]; then sudo mkdir -p $(dirname '${localEnv:HOME}') && sudo ln -sfn /home/vscode '${localEnv:HOME}'; fi"
}