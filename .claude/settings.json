{
  "permissions": {
    "allow": [
      "Bash(cargo doc*)",
      "Bash(cargo bench*)",
      "Bash(cargo test*)",
      "Bash(cargo check*)",
      "Bash(cargo build*)",
      "Bash(just *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(diff *)",
      "mcp__narsil-mcp"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-line-comments.js"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/required-prd-gate.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Use narsil-mcp!'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Prefer narsil-mcp for code search. An empty result is NOT a disconnect and NOT a reason to fall back to grep: the index is fine. Escalate instead — prose query -> semantic_search (BM25, not search_code); exact symbol -> find_symbols/get_symbol_definition; drop file_pattern and simplify the query. Only after that ladder is exhausted use grep. reindex ONLY when on-disk code actually changed. Protocol: docs/agents/narsil.md'"
          }
        ]
      }
    ]
  },
  "autoMemoryEnabled": false,
  "ignorePatterns": [
    "playground/compiler",
    "target",
    "z_outdated",
    "tasks/benchmark/benches/compiler/*",
    "tasks/compiler_tests/cases2/*/case-svelte.js",
    "tasks/compiler_tests/cases2/*/case-rust.js"
  ]
}
