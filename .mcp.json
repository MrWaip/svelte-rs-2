{
  "mcpServers": {
    "narsil-mcp": {
      "command": "narsil-mcp",
      "args": [
        "--repos",
        ".",
        "--git",
        "--watch",
        "--lsp",
        "--persist",
        "--index-path",
        ".claude/cache"
      ]
    },
    "taskmaster-ai": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "task-master-ai"
      ],
      "env": {
        "TASK_MASTER_TOOLS": "standard"
      }
    }
  }
}